# Create a fine-grained or classic GitHub Personal Access Token.
# Public repository read access is sufficient. Keep this file private.
GITHUB_TOKEN=
PER_PAGE=50
MAX_PAGES=2
# PER_PAGE: 1-100; MAX_PAGES: 1-10, subject to GitHub's 1000-result limit.
# Optional: absolute path or path relative to this project directory.
# DB_PATH=data/intel.db
