# =====================================================================
# Personal Hub — Git 忽略规则
# 目标：秘密、本地用户数据、依赖与构建产物永不进入版本库。
# 参考：AGENT.md 第 9.3 节（Git 规范）、第 8.6 节（数据安全）
# =====================================================================

# --- 秘密与本地环境（绝不提交） ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.claude/settings.local.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version.bak
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Node / 前端 ---
node_modules/
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# --- 本地用户数据（Local Data Plane，永不提交） ---
# 运行时数据库、WAL、Vault、索引、日志、备份
personal-hub-data/
data/
vault/
indexes/
backups/
logs/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.db-journal

# --- 临时与产物 ---
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# --- 操作系统 / 编辑器 ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/settings.json
.vscode/*.local.json
